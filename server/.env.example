PORT=5000
NODE_ENV=development
WHISPER_SERVICE_URL=http://localhost:8000
WHISPER_REQUEST_TIMEOUT_MS=1800000 # 30 minutes for long-video transcription
MAX_FILE_SIZE_MB=100

# NVIDIA NIM model configuration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_MS=600000

# Phase 2: Claim extraction (provider options: "nvidia" | "mock")
CLAIM_LLM_PROVIDER=nvidia
CLAIM_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Phase 3: Evidence Retrieval Configuration
# SEARCH_PROVIDER options: "youcom" | "brave" | "mock" (mock returns no real citations)
SEARCH_PROVIDER=youcom
SEARCH_API_KEY=                   # Required for "brave" or "youcom"
EVIDENCE_MAX_QUERIES=3
EVIDENCE_RESULTS_PER_QUERY=5
EVIDENCE_MAX_RESULTS_PER_CLAIM=8
EVIDENCE_REQUEST_TIMEOUT_MS=10000
EVIDENCE_MAX_PAGE_SIZE_MB=2
EVIDENCE_MAX_TEXT_LENGTH=5000
EVIDENCE_MAX_CONCURRENT_FETCHES=3
EVIDENCE_MAX_TOTAL_TIME_MS=30000

# Phase 4: NLI Verification Configuration
# NLI_PROVIDER options: "nvidia" | "mock"
NLI_PROVIDER=nvidia
NLI_LLM_MODEL=meta/llama-3.3-70b-instruct
NLI_MAX_EVIDENCE_PER_CLAIM=5
NLI_CONFIDENCE_THRESHOLD=0.7
